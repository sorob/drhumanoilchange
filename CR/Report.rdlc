  <DataSets>
    <DataSet Name="Labstuff_ResultRef1">
      <rd:DataSetInfo>
        <rd:DataSetName>Labstuff</rd:DataSetName>
        <rd:TableName>ResultRef1</rd:TableName>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>ResultRef1TableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT        ResultRef.Result AS R1, ResultRef_1.Result AS R2, ResultRef.MedScale AS MS1, ResultRef.DocScale AS DS1, ResultRef.DocLow, ResultRef.DocHigh, 
                         ResultRef.DocOpt, ResultRef.MedLow, ResultRef.MedHigh, ResultRef.Medopt, TestRef.Category, TestRef.testName, TestRef.testAbrev, 
                         ResultRef_1.MedScale AS MS2, ResultRef_1.DocScale AS DS2
FROM            ResultRef INNER JOIN
                         ResultRef AS ResultRef_1 ON ResultRef.TestAbrev = ResultRef_1.TestAbrev INNER JOIN
                         TestRef ON ResultRef.TestAbrev = TestRef.testAbrev
WHERE        (ResultRef.Testid = @t1) AND (ResultRef_1.Testid = @t2)</CommandText>
        <DataSourceName>nazdiltarinConnectionString</DataSourceName>
      </Query>
